# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=taskflow

# Server
SERVER_PORT=8080

# pgAdmin
PGADMIN_EMAIL=admin@taskflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Telegram (fill in before running the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# URL мини-апп (HTTPS), например https://yourdomain.com
# Если задан — бот автоматически ставит кнопку меню и отправляет её в /start
MINIAPP_URL=
# Числовая часть TELEGRAM_BOT_TOKEN до двоеточия — не секрет, нужна фронту
# для входа через oauth.telegram.org
VITE_TELEGRAM_BOT_ID=8738130486

# Groq API (основной LLM-провайдер)
GROQ_API_KEY=

# JWT
JWT_SECRET=changeme-in-production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# QA-вход (единственная демо-учётка, см. QaAuthController)
QA_LOGIN_SECRET=

# Опрос очереди напоминаний notification-worker, мс
NOTIFICATION_POLL_INTERVAL_MS=60000

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push (VAPID) — сгенерировать один раз: npx web-push generate-vapid-keys
# Смена ключей обнуляет все существующие подписки пользователей на push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Ucaller (flash-звонок для входа по телефону). Без ключей вход по телефону
# просто не появится в /auth/methods — не обязательно для запуска остального.
UCALLER_SERVICE_ID=
UCALLER_SECRET_KEY=
